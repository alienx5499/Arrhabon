# Privy app id (Privy dashboard, Solana embedded wallets enabled). Empty = read-only mode.
NEXT_PUBLIC_PRIVY_APP_ID=
# Arrhabon API base URL, e.g. http://localhost:8080
NEXT_PUBLIC_API_URL=
# Devnet RPC for the Privy wallet and the blockhash-expiry check (defaults to the public devnet endpoint).
# PUBLIC: NEXT_PUBLIC_* values ship to every browser. Use the public devnet endpoint or a domain-restricted key.
NEXT_PUBLIC_SOLANA_RPC_URL=
# Registered universities and attestors: comma-separated Name=base58Address pairs.
NEXT_PUBLIC_UNIVERSITIES=
NEXT_PUBLIC_ATTESTORS=
# Display names as JSON, address -> name, e.g. {"<base58Address>":"Uni A"}; checked before the lists above.
NEXT_PUBLIC_REGISTRY_NAMES=
# Arrhabon program id the browser checks transactions against before signing (defaults to the deployed devnet id).
NEXT_PUBLIC_PROGRAM_ID=
# Landing page showcase vaults, a JSON list: [{"label":"Released","id":"<vault address>"},{"label":"Refunded","id":"<vault address>"}]
NEXT_PUBLIC_SHOWCASE_VAULTS=
# Public code repository and demo video links (http or https). Unset hides them.
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=
# Public site URL for absolute share-image links, e.g. https://arrhabon.example (defaults to the Vercel URL, then http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
